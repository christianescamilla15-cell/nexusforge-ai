{
  "name": "Gmail AI Classifier",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false
      },
      "id": "gmail-trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "model": "llama3.1:8b",
        "messages": {
          "values": [
            {
              "content": "=Clasifica el siguiente email en una de estas categorias: URGENTE, TRABAJO, PERSONAL, SPAM, NEWSLETTER.\n\nResponde SOLO con el formato:\nCategoria: [CATEGORIA]\nResumen: [1 linea de resumen]\nAccion: [que deberia hacer el usuario]\n\nEmail:\nAsunto: {{ $json.subject }}\nDe: {{ $json.from }}\nContenido: {{ $json.snippet }}"
            }
          ]
        },
        "simplify": true
      },
      "id": "ollama-classify",
      "name": "Clasificar Email",
      "type": "@n8n/n8n-nodes-langchain.ollamaChat",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.message.content }}",
              "rightValue": "URGENTE",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        }
      },
      "id": "if-urgente",
      "name": "Es Urgente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "sendTo": "christianescamilla15@gmail.com",
        "subject": "=URGENTE: {{ $('Gmail Trigger').item.json.subject }}",
        "message": "={{ $('Clasificar Email').item.json.message.content }}\n\n---\nEmail original de: {{ $('Gmail Trigger').item.json.from }}\nAsunto: {{ $('Gmail Trigger').item.json.subject }}"
      },
      "id": "gmail-urgente",
      "name": "Notificar Urgente",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "sendTo": "christianescamilla15@gmail.com",
        "subject": "=Resumen diario de emails clasificados",
        "message": "={{ $('Clasificar Email').item.json.message.content }}\n\nDe: {{ $('Gmail Trigger').item.json.from }}\nAsunto: {{ $('Gmail Trigger').item.json.subject }}"
      },
      "id": "gmail-normal",
      "name": "Log No Urgente",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Clasificar Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clasificar Email": {
      "main": [
        [
          {
            "node": "Es Urgente?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es Urgente?": {
      "main": [
        [
          {
            "node": "Notificar Urgente",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log No Urgente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
