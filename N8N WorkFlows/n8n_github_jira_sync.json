{
  "name": "GitHub Jira Auto-Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {"interval": [{"field": "minutes", "minutesInterval": 10}]}
      },
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "id": "schedule-1"
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/christianescamilla15-cell/MindScrolling/commits?per_page=5",
        "options": {}
      },
      "name": "Get Recent Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "id": "get-commits"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items.slice(0, 3)) {\n  const c = item.json;\n  const msg = c.commit?.message || '';\n  const matches = msg.match(/MS-\\d+/gi) || [];\n  for (const key of matches) {\n    results.push({\n      json: {\n        jiraKey: key.toUpperCase(),\n        message: msg.split('\\n')[0],\n        author: c.commit?.author?.name || 'unknown',\n        sha: (c.sha || '').substring(0, 7),\n        url: c.html_url || ''\n      }\n    });\n  }\n}\n\nif (results.length === 0) {\n  results.push({ json: { skip: true } });\n}\n\nreturn results;"
      },
      "name": "Parse Commits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "id": "parse-commits"
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "notEquals"}
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Has Jira Key?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0],
      "id": "if-key"
    },
    {
      "parameters": {
        "modelId": {"__rl": true, "value": "llama3.1:8b", "mode": "list", "cachedResultName": "llama3.1:8b"},
        "messages": {"values": [{"content": "=Commit de MindScrolling: {{ $json.message }} por {{ $json.author }}. Resume en 1 linea para reporte."}]},
        "options": {}
      },
      "name": "AI Resume Commit",
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [880, 0],
      "id": "ai-resume",
      "credentials": {"ollamaApi": {"id": "B3DJY1FgdiJW8LaF", "name": "Ollama account"}}
    },
    {
      "parameters": {
        "sendTo": "christianescamilla15@gmail.com",
        "subject": "=Jira Update: {{ $('Parse Commits').item.json.jiraKey }} - {{ $('Parse Commits').item.json.message }}",
        "emailType": "text",
        "message": "=Commit detectado para {{ $('Parse Commits').item.json.jiraKey }}:\n\n{{ $('Parse Commits').item.json.message }}\nAutor: {{ $('Parse Commits').item.json.author }}\nSHA: {{ $('Parse Commits').item.json.sha }}\n\nResumen AI: {{ $json.content }}",
        "options": {}
      },
      "name": "Notify Update",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1100, 0],
      "id": "notify",
      "credentials": {"gmailOAuth2": {"id": "AxXoTW1JPu65iByD", "name": "Gmail account"}}
    }
  ],
  "connections": {
    "Every 10 Minutes": {"main": [[{"node": "Get Recent Commits", "type": "main", "index": 0}]]},
    "Get Recent Commits": {"main": [[{"node": "Parse Commits", "type": "main", "index": 0}]]},
    "Parse Commits": {"main": [[{"node": "Has Jira Key?", "type": "main", "index": 0}]]},
    "Has Jira Key?": {"main": [[{"node": "AI Resume Commit", "type": "main", "index": 0}]]},
    "AI Resume Commit": {"main": [[{"node": "Notify Update", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
