# Verification environment — copy to `.env.verify` and fill in.
#
# RULES:
#   - NEVER copy values from your prod `.env`. Generate fresh secrets
#     for every triangulation pass so a leaked verification env can't
#     unlock prod.
#   - LLM keys: triangulators benefit from real cloud LLM calls (catches
#     prompt-cache regressions, fallback-chain breaks). If you want to
#     skip cloud LLMs, leave keys blank — the system falls back to Ollama
#     (slow on first run, free). The Anthropic key is the most useful
#     because it covers the chat-first path AND the security-review session.
#
# Generate symmetric secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # JWT_SECRET
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # FERNET_KEY

# ── Auth / crypto (REQUIRED) ────────────────────────────────────────
JWT_SECRET=
JWT_SIGNING_SECRET=
MYTHOS_HMAC_SECRET=
FERNET_KEY=

# ── LLM providers (recommend at least ANTHROPIC_API_KEY) ────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# ── Feature flags ────────────────────────────────────────────────────
ENABLE_REFRESH_TOKENS=true
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:15173

# ── Stripe (leave blank — billing not exercised in verification) ─────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Platform Synthesizer sandbox ─────────────────────────────────────
# All synthesizer-generated projects must land under this dir during
# verification. The functionality smoke uses a tmp subdir; setting a
# verify-specific root means a stale prior run can be wiped without
# touching the user's real ~/nexusforge-generated.
PLATFORM_SYNTH_ROOT=/tmp/nexusforge_verify_synth
